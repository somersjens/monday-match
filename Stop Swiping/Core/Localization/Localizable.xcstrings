        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heb je kinderen?"
          }
        }
      }
    },
    "Do you keep affection for at home, or do you also like to show it in public?" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you keep affection for at home, or do you also like to show it in public?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knuffel en zoen je liever alleen thuis, of ook gewoon waar anderen bij zijn?"
          }
        }
      }
    },
    "Do you keep birthdays and special days small, or do you go all out?" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you keep birthdays and special days small, or do you go all out?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vier je verjaardagen en bijzondere dagen klein, of pak je groots uit?"
          }
        }
      }
    },
    "Do you keep your feelings to yourself, or can people see right away how you feel?" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you keep your feelings to yourself, or can people see right away how you feel?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd je je gevoelens liever voor je, of kunnen anderen meteen aan je zien hoe je je voelt?"
          }
        }
      }
    },
    "Do you keep your successes to yourself, or do you proudly share them?" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you keep your successes to yourself, or do you proudly share them?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd je je successen liever voor jezelf, of vertel je er trots over?"
          }
        }
      }
    },
    "Do you like having few social plans, or do you prefer a full calendar?" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you like having few social plans, or do you prefer a full calendar?"
