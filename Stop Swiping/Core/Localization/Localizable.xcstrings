    "amplify_ui_liveness_get_ready_photosensitivity_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This check flashes different colors. Use caution if you are photosensitive."
