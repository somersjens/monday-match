    },
    "amplify_ui_liveness_get_ready_photosensitivity_dialog_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some people may experience epileptic seizures when exposed to colored lights. Use caution if you, or anyone in your family, have an epileptic condition."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige mensen kunnen een epileptische aanval krijgen door gekleurde lichten. Wees voorzichtig als jij of iemand in je familie epilepsie heeft."
          }
        }
      }
    },
