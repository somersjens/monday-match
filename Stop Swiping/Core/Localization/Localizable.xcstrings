        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volg je het nieuws nauwelijks, of houd je het elke dag bij?"
          }
        }
      }
    },
    "Do you have children?" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you have children?"
