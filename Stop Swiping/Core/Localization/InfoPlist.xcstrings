    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the front camera to compare a live face scan with your chosen profile photo. The scan is processed on this device and is not saved or uploaded."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik de frontcamera om een live gezichtsscan te vergelijken met je gekozen profielfoto. De scan wordt op dit apparaat verwerkt en niet opgeslagen of geüpload."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location is used to find matches within the distance you choose. Only an approximate location is stored and your exact coordinates are never shown on your profile."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je locatie wordt gebruikt om matches te vinden binnen de afstand die je kiest. Alleen een globale locatie wordt opgeslagen. Je exacte coördinaten worden nooit op je profiel getoond."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose photos from your library to use on your profile."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies foto's uit je bibliotheek voor je profiel."
          }
        }
      }
    }
  },
