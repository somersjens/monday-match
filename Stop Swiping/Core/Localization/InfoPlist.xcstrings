    },
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stop Swiping"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera scans profile codes and verifies your chosen photo. Offline scans stay on this iPhone. If you choose server verification, the live face video and photo are processed by AWS in Ireland after your consent."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De camera scant profielcodes en verifieert je gekozen foto. Offline scans blijven op deze iPhone. Als je voor serververificatie kiest, worden de live gezichtsopname en foto na jouw toestemming door AWS in Ierland verwerkt."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location is used to find matches within the distance you choose. Only an approximate location is stored and your exact coordinates are never shown on your profile."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je locatie wordt gebruikt om matches te vinden binnen de afstand die je kiest. Alleen een globale locatie wordt opgeslagen. Je exacte coördinaten worden nooit op je profiel getoond."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose photos from your library to use on your profile."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies foto's uit je bibliotheek voor je profiel."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop Swiping uses your local network to find the phone you hold yours against, so the two of you can exchange profiles directly."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop Swiping gebruikt je lokale netwerk om de telefoon te vinden waar je de jouwe tegenaan houdt, zodat jullie rechtstreeks profielen kunnen uitwisselen."
          }
        }
      }
    },
    "NSNearbyInteractionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop Swiping measures the distance to another phone, so profiles are only exchanged when you hold your phones together."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop Swiping meet de afstand tot een andere telefoon, zodat profielen alleen worden uitgewisseld als jullie de telefoons tegen elkaar houden."
          }
        }
      }
    }
  },
  "version" : "1.0"
}